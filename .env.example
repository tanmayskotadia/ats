# Add a server-side key to enable AI-assisted scanning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Use a shared Redis instance for rate limits across production replicas.
REDIS_URL=
AI_CONCURRENCY=6
AI_REQUESTS_PER_CLIENT=24
AI_REQUESTS_PER_MINUTE=120
AI_TIMEOUT_MS=45000

# Bind to 0.0.0.0 when running in a container or behind a proxy.
HOST=127.0.0.1
PORT=5173
# Set only when the origin is reachable exclusively through this many trusted proxy hops.
TRUST_PROXY_HOPS=0
