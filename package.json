{
  "name": "ats-reader",
  "version": "1.0.0",
  "description": "Browser-based resume parser and ATS scorecard",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "predev": "node --experimental-strip-types scripts/prepare-assets.ts",
    "prebuild": "node --experimental-strip-types scripts/prepare-assets.ts",
    "start": "node --experimental-strip-types --env-file-if-exists=.env server/index.ts",
    "models:download": "node --experimental-strip-types scripts/download-model.ts",
    "models:benchmark": "node --experimental-strip-types scripts/benchmark-model.ts",
    "models:audit": "node --experimental-strip-types scripts/audit-evidence.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanmayskotadia/ats.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/tanmayskotadia/ats/issues"
  },
  "homepage": "https://github.com/tanmayskotadia/ats#readme",
  "dependencies": {
    "@ai-sdk/groq": "^4.0.86",
    "@ai-sdk/openai": "^4.0.114",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "ai": "^7.0.169",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-static": "^1.72.0",
    "pdfjs-dist": "^6.5.438",
    "redis": "^6.3.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
